# HOSPITALITY Environment Configuration
# Copy this file to .env and configure local values

# Environment
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

# Database (Default: SQLite for portable local execution)
DATABASE_URL=sqlite+aiosqlite:///./data/hospitality.db
# PostgreSQL Alternative:
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/hospitality

# Security
SECRET_KEY=hospitality-dev-secret-key-gehealthcare-2026

# AI / LLM Configuration
LLM_PROVIDER=mock
# Options: mock, gemini, openai, anthropic
GEMINI_API_KEY=
OPENAI_API_KEY=
LLM_MODEL=gemini-1.5-flash

# National Digital Health Ecosystem (ABDM / NHA Sandbox)
ABDM_CLIENT_ID=
ABDM_CLIENT_SECRET=
ABDM_BASE_URL=https://dev.abdm.gov.in
NHCX_BASE_URL=https://hcxsbx.abdm.gov.in

# Open Government Data (data.gov.in)
DATA_GOV_IN_API_KEY=
DATA_GOV_IN_BASE_URL=https://api.data.gov.in

# Storage Directories
UPLOAD_DIR=./data/raw/uploads
PROCESSED_DATA_DIR=./data/processed
SYNTHETIC_DATA_DIR=./data/synthetic
